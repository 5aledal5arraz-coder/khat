# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# uploaded data (audio files, etc.)
/data

# runtime cache / data
config/episode-cache.json
config/episode-versions.json
config/*.tmp

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# QA scratch — safe to delete
_QA_TRASH_delete_me/

# Agent/session scratch — patches, reports, DB backups written during dev
# sessions. May contain sensitive data (backup dumps); never commit.
scratchpad/

# Claude Code local permission allowlist — machine-local, may capture
# credential-bearing commands; scrubbed from history 2026-07-11. Never commit.
.claude/settings.local.json

# Admin-uploaded PARTNER LOGOS — same rule as the teasers below, and for the
# same reason: they are runtime media written by an upload route
# (app/api/admin/partnerships/upload/route.ts), not source. Production had one
# logo the repo had never seen and the repo had one production had never seen;
# committing user uploads is how that happens. They still reach the server —
# rsync does not read .gitignore — they just stop being versioned.
public/partners/

# Admin-uploaded teaser videos — runtime media on disk (public/teasers/),
# recreated by the upload route. Never commit uploaded/test videos.
public/teasers/

# Guest voice notes — runtime media written by the testimonial upload route.
# Same category as teasers above: uploaded on the machine that serves them,
# never part of a build, and pointless to version.
public/testimonials/

# Commercial documents — NEVER committed. This repository is PUBLIC, so a
# partnership draft here would publish KHAT's prices, margins, cancellation
# policy and negotiating position to anyone who clones it. Caught once by
# `git add -A` sweeping the file in; the ignore is what stops the next sweep.
docs/partnership-terms-draft.md
docs/*-terms-*.md
docs/*-contract-*.md
youtube-sync-backup-*.json
quotes-backup-*.json
guests-backup-*.json
guest-honorifics-backup-*.json
visitor-tracking-backup-*.json
